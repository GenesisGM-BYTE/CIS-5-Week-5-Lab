[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run C++ assignment"

[[workflows.workflow]]
name = "Run C++ assignment"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "g++ -std=c++17 -o program main.cpp && ./program"

[workflows.workflow.metadata]
outputType = "console"
